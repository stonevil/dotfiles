#!/usr/bin/env bash
# vim:ft=bash

trap "exit" INT

media_url="$@"

if [[ -z "${media_url}" ]]; then
	read -p "Please provide URL: " media_url
fi

yt_user_agent={{ .web.ytUserAgent | quote }}

cd {{ (joinPath .chezmoi.homeDir "Downloads") | quote }} || exit 1

yt-dlp -4 --no-warnings --no-check-certificate --user-agent "$yt_user_agent" --embed-metadata --embed-thumbnail -x --audio-format m4a "$media_url"
