-- Cursor size
hl.env("HYPRCURSOR_SIZE", "24")
hl.env("XCURSOR_SIZE", "24")
hl.env("QT_CURSOR_SIZE", "24")
hl.env("RUST_BACKTRACE", "1")

-- Force all apps to use Wayland
hl.env("GDK_BACKEND", "wayland,x11,*")

hl.env("QT_QPA_PLATFORM", "wayland;xcb")
hl.env("QT_QPA_PLATFORMTHEME", "qt6ct")
hl.env("QT_QPA_PLATFORMTHEME_QT6", "qt6ct")
-- hl.env("QT_QPA_PLATFORMTHEME", "kde**". "**")
-- hl.env("QT_STYLE_OVERRIDE", "Breeze Black")
hl.env("QT_WAYLAND_DISABLE_WINDOWDECORATION", "1")

hl.env("QT_QUICK_CONTROLS_STYLE", "org.hyprland.style")

hl.env("SDL_VIDEODRIVER", "wayland")
hl.env("CLUTTER_BACKEND", "wayland")
hl.env("GTK_THEME", "Breeze-Dark")

-- hl.env("WLR_NO_HARDWARE_CURSORS", "1")

hl.env("_JAVA_AWT_WM_NONREPARENTING", "1")
hl.env("MOZ_ENABLE_WAYLAND", "1")
-- hl.env("MOZ_DISABLE_RDD_SANDBOX", "1")
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "wayland")
hl.env("OZONE_PLATFORM", "wayland")

-- Allow better support for screen sharing (Google Meet, Discord, etc)
hl.env("XDG_CURRENT_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_TYPE", "wayland")

hl.env("XDG_MENU_PREFIX", "arch-")

-- XWayland apps scale fix
hl.env("GDK_SCALE", "1")
hl.env("QT_SCALE_FACTOR", "1")
hl.env("QT_AUTO_SCREEN_SCALE_FACTOR", "1")

-- Screnshots location
hl.env("HYPRSHOT_DIR", homeDirPath .. "/Downloads")

-- Use XCompose file
hl.env("XCOMPOSEFILE", homeDirPath .. "/.XCompose")

{{- if .tags.nvidia.enabled }}
hl.env("GBM_BACKEND", "nvidia-drm")
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
hl.env("LIBVA_DRIVER_NAME", "nvidia")
{{- end }}
