{{- /*
	vim:ft=conf.gotexttmpl
*/ -}}

[org.kde.dolphin]
cmd.up = A-up
cmd.down = enter
cmd.[ = A-left
cmd.] = A-right
cmd+shift.h = A-home
cmd+shift.n = F10
cmd.i = A-enter
cmd+shift.. = C-h

[foot]
# add simple copy/paste
cmd.c = C-S-c
cmd.v = C-S-v
# preserv keys
alt.left = A-left
alt.right = A-right

[com.mitchellh.ghostty]
# add simple copy/paste
cmd.c = C-S-c
cmd.v = C-S-v
# preserv keys
alt.left = A-left
alt.right = A-right

[librewolf]
cmd+alt.l = C-S-y

[waterfox]
cmd+alt.l = C-S-y

[firefox]
cmd+alt.l = C-S-y

[chromium]
cmd+alt.l = C-j

[helium]
cmd+alt.l = C-j
