[colors]

# UI colors
cursor       = {{ (print "#" .colours.cursor.cursor) | squote }}
vi-cursor    = {{ (print "#" .colours.cursor.vi_mode.cursor) | squote }}

tabs         = {{ if .theme.blackout }}'#000000'{{ else }}{{ (print "#" .colours.normal.background) | squote }}{{ end }}
tabs-active  = {{ (print "#" .colours.cursor.vi_mode.cursor) | squote }}
split        = {{ (print "#" .colours.normal.blue) | squote }}
split-active = {{ (print "#" .colours.normal.blue) | squote }}


# Search
search-match-background         = {{ (print "#" .colours.search.matches.background) | squote }}
search-match-foreground         = {{ (print "#" .colours.search.matches.foreground) | squote }}
search-focused-match-background = {{ (print "#" .colours.search.focused_match.background) | squote }}
search-focused-match-foreground = {{ (print "#" .colours.search.focused_match.foreground) | squote }}


# Hints
hint-foreground = {{ (print "#" .colours.hints.start.foreground) | squote }}
hint-background = {{ (print "#" .colours.hints.start.background) | squote }}


# Selection
selection-foreground   = {{ (print "#" .colours.selection.text) | squote }}
selection-background   = {{ (print "#" .colours.selection.background) | squote }}


# Regular
foreground = {{ (print "#" .colours.normal.foreground) | squote }}
background = {{ if .theme.blackout }}'#000000'{{ else }}{{ (print "#" .colours.normal.background) | squote }}{{ end }}
black      = {{ if .theme.blackout }}'#000000'{{ else }}{{ (print "#" .colours.normal.black) | squote }}{{ end }}
white      = {{ (print "#" .colours.normal.white) | squote }}
blue       = {{ (print "#" .colours.normal.blue) | squote }}
cyan       = {{ (print "#" .colours.normal.cyan) | squote }}
green      = {{ (print "#" .colours.normal.green) | squote }}
magenta    = {{ (print "#" .colours.normal.magenta) | squote }}
red        = {{ (print "#" .colours.normal.red) | squote }}
yellow     = {{ (print "#" .colours.normal.yellow) | squote }}


# Dim colors
dim-foreground  = {{ (print "#" .colours.normal.foreground) | squote }}
dim-black       = {{ if .theme.blackout }}'#000000'{{ else }}{{ (print "#" .colours.normal.black) | squote }}{{ end }}
dim-white       = {{ (print "#" .colours.normal.white) | squote }}
dim-blue        = {{ (print "#" .colours.normal.blue) | squote }}
dim-cyan        = {{ (print "#" .colours.normal.cyan) | squote }}
dim-green       = {{ (print "#" .colours.normal.green) | squote }}
dim-magenta     = {{ (print "#" .colours.normal.magenta) | squote }}
dim-red         = {{ (print "#" .colours.normal.red) | squote }}
dim-yellow      = {{ (print "#" .colours.normal.yellow) | squote }}


# Light colors
light-foreground = {{ (print "#" .colours.bright.foreground) | squote }}
light-black      = {{ (print "#" .colours.bright.black) | squote }}
light-white      = {{ (print "#" .colours.bright.white) | squote }}
light-blue       = {{ (print "#" .colours.bright.blue) | squote }}
light-cyan       = {{ (print "#" .colours.bright.cyan) | squote }}
light-green      = {{ (print "#" .colours.bright.green) | squote }}
light-magenta    = {{ (print "#" .colours.bright.magenta) | squote }}
light-red        = {{ (print "#" .colours.bright.red) | squote }}
light-yellow     = {{ (print "#" .colours.bright.yellow) | squote }}
