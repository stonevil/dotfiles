<openbox_menu>
	<menu id="client-menu">
		<item label="  Minimize">
			<action name="Iconify" />
		</item>
		<item label="  Maximize">
			<action name="ToggleMaximize" />
		</item>
		<item label="  Fullscreen">
			<action name="ToggleFullscreen" />
		</item>
		<item label="  Shade">
			<action name="ToggleShade" />
		</item>
		<item label="  On Top">
			<action name="ToggleAlwaysOnTop" />
		</item>
		<item label="  On Bottom">
			<action name="ToggleAlwaysOnBottom" />
		</item>
		<menu id="workspaces" label="  Workspace">
			<item label="  Move left">
				<action name="SendToDesktop" to="left" />
			</item>
			<item label="  Move right">
				<action name="SendToDesktop" to="right" />
			</item>
			<separator />
			<item label="  Sticky">
				<action name="ToggleOmnipresent" />
			</item>
		</menu>
		<item label="  Close">
			<action name="Close" />
		</item>
	</menu>

	<menu id="root-menu">
		<item label="  Terminal">
			<action name="Execute" command="foot" />
		</item>
		<menu id="dev" label="  Development">
			<item label="  NeoVim">
				<action name="Execute" command="foot -e nvim" />
			</item>
		</menu>
		<menu id="web" label="󰖟  Web">
			<item label="  Librewolf">
				<action name="Execute" command="librewolf" />
			</item>
			<item label="  Chromium">
				<action name="Execute" command="chromium" />
			</item>
		</menu>
		<menu id="office" label="󰏆  Office">
			<item label="󱢴  File Browser">
				<action name="Execute" command="dolphin" />
			</item>
			<item label="  Mail">
				<action name="Execute" command="thunderbird" />
			</item>
		</menu>
		<separator />
		<menu id="Next" label="  Running...">
			<menu id="client-list-combined-menu" />
		</menu>
		<separator />
		<item label="  Reconfigure">
			<action name="Reconfigure" />
		</item>
		<separator />
		<menu id="system" label="  System">
			<item label="󰿅  Exit">
				<action name="Exit"/>
			</item>
			<item label="  Lock">
				<action name="Execute" command="noctalia msg session lock" />
			</item>
			<item label="󰒲  Sleep">
				<action name="Execute" command="noctalia msg session lock-and-suspend"/>
			</item>
			<item label="  Reboot">
				<action name="Execute" command="noctalia msg session reboot"/>
			</item>
			<item label="  Shutdown">
				<action name="Execute" command="noctalia msg session shutdown"/>
			</item>
		</menu>
	</menu>
</openbox_menu>
